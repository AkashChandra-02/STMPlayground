	// LDREX/STREX
	// __LDREXB(addr);
	// __STREXB((val), (addr)))
	// __CLREX();

int init_semaphore(semaphore* s){
	s->value = NULL;
	s->status = freed;
}

int spin_lock(semaphore* s, uint8_t value){
	do{
		__STREXB((locked), (&(s->status)));
		__STREXB((value), (&(s->value)));
	}while(__LDREXB(&(s->status)) != freed);
	return 1;
}

int lock(semaphore* s, uint8_t value){
	__STREXB((locked), (&(s->status)));
	__STREXB((value), (&(s->value)));
	return 1;
}

int check_for_free(semaphore* s){
	return __LDREXB(&(s->status)) == freed? 1 : 0;
}

uint8_t get_value(semaphore* s){
	uint8_t return_value = NULL;
	if (__LDREXB(&(s->status)) == locked){
		return_value = __LDREXB(&(s->value));
	}
	return return_value;
}

int unlock(semaphore* s){
	__STREXB((freed), (&(s->status)));
	__STREXB((NULL), (&(s->value)));
	return 1;
}
